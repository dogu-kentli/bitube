{{ header }}

<main id="account-newsletter" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="grid" style="display:grid;grid-template-columns:1fr 320px;gap:20px;">
      <section class="modern-card p-5">
        <h1 class="card-title">{{ heading_title }}</h1>
        <p class="text-sm text-muted">{{ text_account }}</p>

        <form action="{{ action }}" method="post" class="mt-4 space-y-4">
          <div class="form-group">
            <label class="form-label">{{ entry_newsletter }}</label>
            <div class="space-x-4">
              <label class="inline-flex items-center gap-2"><input type="radio" name="newsletter" value="1" {% if newsletter %}checked{% endif %}/> {{ text_yes }}</label>
              <label class="inline-flex items-center gap-2"><input type="radio" name="newsletter" value="0" {% if not newsletter %}checked{% endif %}/> {{ text_no }}</label>
            </div>
          </div>

          <div class="flex items-center justify-between">
            <a href="{{ back }}" class="btn btn-ghost">{{ button_back }}</a>
            <button type="submit" class="btn btn-primary">{{ button_continue }}</button>
          </div>
        </form>

      </section>

      <aside>{{ column_right }}</aside>
    </div>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
