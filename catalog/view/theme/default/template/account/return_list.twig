{{ header }}

<main id="account-return-list" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <section class="modern-card p-5">
      <h1 class="card-title">{{ heading_title }}</h1>

      {% if returns %}
        <div class="table-responsive mt-4">
          <table class="table">
            <thead>
              <tr><th>{{ column_return_id }}</th><th>{{ column_order_id }}</th><th>{{ column_status }}</th><th class="text-right">{{ column_action }}</th></tr>
            </thead>
            <tbody>
              {% for return in returns %}
                <tr>
                  <td>{{ return.return_id }}</td>
                  <td>{{ return.order_id }}</td>
                  <td>{{ return.status }}</td>
                  <td class="text-right"><a href="{{ return.view }}" class="btn btn-ghost">{{ button_view }}</a></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="mt-4">{{ text_empty }}</div>
      {% endif %}

    </section>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
