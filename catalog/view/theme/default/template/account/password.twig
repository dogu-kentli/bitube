{{ header }}
<style>
html.dark #account-password-page { background:#020617!important; color:#e2e8f0!important; }
html.dark #account-password-page .overflow-hidden.rounded-3xl { background:#111827!important; border-color:#334155!important; }
html.dark #account-password-page .border-slate-100 { border-color:#334155!important; }
html.dark #account-password-page h1 { color:#f1f5f9!important; }
html.dark #account-password-page p,
html.dark #account-password-page label { color:#cbd5e1!important; }
html.dark #account-password-page nav a { color:#94a3b8!important; }
html.dark #account-password-page nav [aria-current="page"] { color:#a5b4fc!important; }
html.dark #account-password-page input[type="password"] { background:#0b1220!important; border-color:#475569!important; color:#e2e8f0!important; }
html.dark #account-password-page input[type="password"]::placeholder { color:#64748b!important; }
html.dark #account-password-page a:not(:hover) { color:#cbd5e1; }
html.dark #account-password-page .bg-indigo-50 { background:#1e1b4b!important; }
html.dark #account-password-page .text-indigo-600 { color:#a5b4fc!important; }
html.dark #account-password-page button[type="submit"] { background:#4f46e5!important; color:#fff!important; }
html.dark #account-password-page button[type="submit"]:hover { background:#6366f1!important; }
html.dark #account-password-page a.border-slate-300 { background:#1e293b!important; border-color:#475569!important; color:#e2e8f0!important; }
</style>
<main id="account-password-page" class="flex-1 w-full bg-slate-50 px-4 py-8 text-slate-800 dark:bg-slate-950 dark:text-slate-100 sm:px-6 sm:py-10">
  <div class="mx-auto max-w-7xl">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
        {% for breadcrumb in breadcrumbs %}
        <li class="flex items-center gap-2">{% if not loop.first %}<i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>{% endif %}{% if loop.last %}<span class="font-semibold text-indigo-600 dark:text-indigo-400" aria-current="page">{{ breadcrumb.text }}</span>{% else %}<a href="{{ breadcrumb.href }}" class="transition hover:text-indigo-600 dark:hover:text-indigo-400">{{ breadcrumb.text }}</a>{% endif %}</li>
        {% endfor %}
      </ol>
    </nav>
    <div class="row">
      {{ column_left }}
      <section class="min-w-0 {% if column_left and column_right %}col-sm-6{% elseif column_left or column_right %}col-sm-9{% else %}col-sm-12{% endif %}">
        {{ content_top }}
        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
          <div class="border-b border-slate-100 px-5 py-5 dark:border-slate-800 sm:px-7">
            <div class="flex items-center gap-3">
              <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-300"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
              <div><h1 class="text-xl font-extrabold text-slate-900 dark:text-white">{{ heading_title }}</h1><p class="mt-1 text-sm text-slate-500 dark:text-slate-400">Hesabınızın güvenliği için güçlü bir parola belirleyin.</p></div>
            </div>
          </div>
          <div class="p-5 sm:p-7">
            <form action="{{ action }}" method="post" enctype="multipart/form-data" class="space-y-5">
              <div class="grid gap-2 sm:grid-cols-[190px_minmax(0,1fr)] sm:items-start">
                <label class="pt-3 text-sm font-semibold text-slate-600 dark:text-slate-300" for="input-password">{{ entry_password }}</label>
                <div><input type="password" name="password" value="{{ password }}" placeholder="{{ entry_password }}" id="input-password" autocomplete="new-password" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />{% if error_password %}<p class="mt-1.5 text-sm text-rose-600 dark:text-rose-400">{{ error_password }}</p>{% endif %}</div>
              </div>
              <div class="grid gap-2 sm:grid-cols-[190px_minmax(0,1fr)] sm:items-start">
                <label class="pt-3 text-sm font-semibold text-slate-600 dark:text-slate-300" for="input-confirm">{{ entry_confirm }}</label>
                <div><input type="password" name="confirm" value="{{ confirm }}" placeholder="{{ entry_confirm }}" id="input-confirm" autocomplete="new-password" class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm text-slate-900 outline-none transition placeholder:text-slate-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-500/20 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-100" />{% if error_confirm %}<p class="mt-1.5 text-sm text-rose-600 dark:text-rose-400">{{ error_confirm }}</p>{% endif %}</div>
              </div>
              <div class="flex flex-col-reverse gap-3 border-t border-slate-100 pt-5 dark:border-slate-800 sm:flex-row sm:justify-between">
                <a href="{{ back }}" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-600 transition hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>{{ button_back }}</a>
                <button type="submit" class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"><i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>{{ button_continue }}</button>
              </div>
            </form>
            {{ content_bottom }}
          </div>
        </div>
      </section>
      {{ column_right }}
    </div>
  </div>
</main>
{{ footer }}
