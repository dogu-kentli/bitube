{{ header }}

<main id="account-forgotten" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="grid" style="display:grid;grid-template-columns:1fr 320px;gap:20px;">
      <section class="modern-card">
        <div class="card-head"><h1 class="card-title">{{ heading_title }}</h1></div>

        <form action="{{ action }}" method="post" class="p-5 space-y-4">
          <p class="text-sm text-muted">{{ text_your_email }}</p>

          <div class="form-group">
            <label class="form-label" for="input-email">{{ entry_email }}</label>
            <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control" />
            {% if error_warning %}<div class="text-danger mt-1">{{ error_warning }}</div>{% endif %}
          </div>

          <div class="flex items-center justify-between mt-4">
            <a href="{{ back }}" class="btn btn-ghost">{{ button_back }}</a>
            <button type="submit" class="btn btn-primary">{{ button_continue }}</button>
          </div>
        </form>
      </section>

      <aside>{{ column_right }}</aside>
    </div>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
