{{ header }}

<main id="account-wishlist" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <section class="modern-card p-5">
      <h1 class="card-title">{{ heading_title }}</h1>

      {% if products %}
        <div class="table-responsive mt-4">
          <table class="table">
            <thead><tr><th>{{ column_image }}</th><th>{{ column_name }}</th><th class="text-right">{{ column_price }}</th><th></th></tr></thead>
            <tbody>
              {% for product in products %}
                <tr>
                  <td><img src="{{ product.thumb }}" alt="{{ product.name }}" class="h-12 w-12 object-cover rounded"/></td>
                  <td>{{ product.name }}</td>
                  <td class="text-right">{{ product.price }}</td>
                  <td class="text-right"><a href="{{ product.cart }}" class="btn btn-primary">{{ button_cart }}</a></td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="mt-4">{{ text_empty }}</div>
      {% endif %}

    </section>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
