{{ header }}

<main id="account-logout" class="flex-1 w-full bg-slate-50 px-4 py-8 text-slate-800 dark:bg-slate-950 dark:text-slate-100 sm:px-6 sm:py-10">
    <div class="mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-6">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                {% for breadcrumb in breadcrumbs %}
                <li class="flex items-center gap-2">
                    {% if not loop.first %}<i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>{% endif %}
                    {% if loop.last %}<span class="font-semibold text-indigo-600 dark:text-indigo-400" aria-current="page">{{ breadcrumb.text }}</span>
                    {% else %}<a href="{{ breadcrumb.href }}" class="transition hover:text-indigo-600 dark:hover:text-indigo-400">{{ breadcrumb.text }}</a>{% endif %}
                </li>
                {% endfor %}
            </ol>
        </nav>

        {{ content_top }}

        <section class="mx-auto max-w-2xl overflow-hidden rounded-3xl border border-slate-200 bg-white text-center shadow-sm dark:border-slate-800 dark:bg-slate-900">
            <div class="px-6 py-10 sm:px-12 sm:py-14">
                <span class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-600 dark:bg-emerald-950/50 dark:text-emerald-300">
                    <i class="fa-solid fa-circle-check text-3xl" aria-hidden="true"></i>
                </span>
                <h1 class="mt-6 text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white sm:text-3xl">{{ heading_title }}</h1>
                <div class="mx-auto mt-4 max-w-lg space-y-2 text-sm leading-6 text-slate-600 dark:text-slate-300">{{ text_message|raw }}</div>
                <a href="{{ continue }}" class="mt-8 inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900">
                    <i class="fa-solid fa-house" aria-hidden="true"></i>{{ button_continue }}
                </a>
            </div>
        </section>

        {{ content_bottom }}
    </div>
</main>

{{ footer }}
