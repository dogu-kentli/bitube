{{ header }}

<main id="account-order-info" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="modern-card p-5">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h1 class="card-title">{{ heading_title }}</h1>
          <p class="text-sm text-muted">{{ text_order_id }}: <strong>{{ order_id }}</strong></p>
        </div>
        <div class="text-right">
          <a href="{{ invoice }}" class="btn btn-ghost">{{ text_invoice }}</a>
        </div>
      </div>

      <div class="mt-4 table-responsive">
        <table class="table">
          <tbody>
            {% for product in products %}
              <tr>
                <td>{{ product.name }}</td>
                <td class="text-right">{{ product.quantity }} x {{ product.total }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <div class="mt-4">
        <h3 class="font-bold">{{ text_order_status }}</h3>
        <ul class="list-disc pl-5 mt-2 text-sm text-muted">
          {% for history in histories %}
            <li>{{ history.date_added }} — {{ history.status }}{% if history.comment %} — {{ history.comment }}{% endif %}</li>
          {% endfor %}
        </ul>
      </div>

      <div class="mt-4 text-right">
        <a href="{{ back }}" class="btn btn-ghost">{{ button_continue }}</a>
      </div>
    </div>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
