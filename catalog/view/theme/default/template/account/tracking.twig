{{ header }}

<main id="account-tracking" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <section class="modern-card p-5">
      <h1 class="card-title">{{ heading_title }}</h1>
      <p class="text-sm text-muted">{{ text_description }}</p>

      <form action="{{ action }}" method="post" class="mt-4 space-y-4">
        <div class="form-group">
          <label class="form-label" for="input-tracking">{{ entry_tracking }}</label>
          <input type="text" name="tracking" id="input-tracking" class="form-control" />
        </div>

        <div class="flex items-center justify-between mt-4">
          <a href="{{ back }}" class="btn btn-ghost">{{ button_back }}</a>
          <button type="submit" class="btn btn-primary">{{ button_tracking }}</button>
        </div>
      </form>
    </section>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
