{{ header }}

<main id="account-address-list" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    {% if success %}
      <div class="alert alert-success mb-4"><span class="icon"><i class="fa-solid fa-circle-check"></i></span><div>{{ success }}</div></div>
    {% endif %}

    {% if error_warning %}
      <div class="alert alert-danger mb-4"><span class="icon"><i class="fa-solid fa-exclamation-triangle"></i></span><div>{{ error_warning }}</div></div>
    {% endif %}

    <div class="grid" style="display:grid;grid-template-columns: 1fr 320px; gap:20px;">
      <section class="modern-card">
        <div class="card-head">
          <div>
            <h1 class="card-title">{{ heading_title }}</h1>
            <div class="card-sub">{{ text_address }}</div>
          </div>
          <a href="{{ add }}" class="btn btn-primary">{{ button_add }}</a>
        </div>

        <div class="p-0">
          {% if addresses %}
            <div class="grid gap-4 md:grid-cols-2 p-5">
              {% for result in addresses %}
                <article class="modern-card">
                  <div class="mb-3 text-xs font-bold uppercase tracking-wider text-indigo-600"><i class="fa-solid fa-house"></i> {{ result.address_1 }}</div>
                  <address class="text-sm leading-6">{{ result.address }}</address>
                  <div class="mt-4 flex flex-wrap gap-2">
                    <a href="{{ result.update }}" class="btn btn-ghost">{{ button_update }}</a>
                    <a href="{{ result.delete }}" title="{{ button_delete }}" onclick="return confirm('{{ text_confirm }}')" class="btn btn-ghost text-rose-600">{{ button_delete }}</a>
                  </div>
                </article>
              {% endfor %}
            </div>
          {% else %}
            <div class="modern-card text-center p-8">
              <div class="text-lg font-bold">{{ text_empty }}</div>
            </div>
          {% endif %}

          <div class="p-5 border-t">
            <a href="{{ back }}" class="btn btn-ghost">{{ button_back }}</a>
          </div>
        </div>

      </section>

      <aside>
        {{ column_right }}
      </aside>
    </div>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
