{{ header }}

<main id="account-voucher" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <section class="modern-card p-5">
      <h1 class="card-title">{{ heading_title }}</h1>

      {% if vouchers %}
        <div class="table-responsive mt-4">
          <table class="table">
            <thead><tr><th>{{ column_code }}</th><th>{{ column_from }}</th><th class="text-right">{{ column_amount }}</th></tr></thead>
            <tbody>
              {% for voucher in vouchers %}
                <tr>
                  <td>{{ voucher.code }}</td>
                  <td>{{ voucher.from }}</td>
                  <td class="text-right">{{ voucher.amount }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="mt-4">{{ text_empty }}</div>
      {% endif %}

      <div class="mt-4 text-right"><a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a></div>
    </section>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
