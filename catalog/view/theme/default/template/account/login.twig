{{ header }}

<main id="account-login" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="grid" style="display:grid;grid-template-columns:1fr 360px;gap:20px;">
      <section class="modern-card">
        <div class="card-head"><h1 class="card-title">{{ heading_title }}</h1></div>

        <form action="{{ action }}" method="post" class="p-5 space-y-4">
          {% if error_warning %}<div class="alert alert-danger"><span class="icon"><i class="fa-solid fa-exclamation-triangle"></i></span><div>{{ error_warning }}</div></div>{% endif %}

          <div class="form-group">
            <label class="form-label" for="input-email">{{ entry_email }}</label>
            <input type="email" name="email" value="{{ email }}" id="input-email" class="form-control" />
          </div>

          <div class="form-group">
            <label class="form-label" for="input-password">{{ entry_password }}</label>
            <input type="password" name="password" id="input-password" class="form-control" />
          </div>

          <div class="flex items-center justify-between">
            <label class="inline-flex items-center gap-2"><input type="checkbox" name="redirect" value="1" /> {{ text_remember }}</label>
            <a href="{{ forgotten }}" class="text-sm text-muted">{{ text_forgotten }}</a>
          </div>

          <div class="flex items-center justify-between mt-4">
            <a href="{{ register }}" class="btn btn-ghost">{{ text_register }}</a>
            <button type="submit" class="btn btn-primary">{{ button_login }}</button>
          </div>
        </form>

      </section>

      <aside class="modern-card p-5">
        {{ column_right }}
      </aside>
    </div>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
