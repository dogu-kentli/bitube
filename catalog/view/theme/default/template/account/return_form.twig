{{ header }}

<main id="account-return-form" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <section class="modern-card p-5">
      <h1 class="card-title">{{ heading_title }}</h1>

      <form action="{{ action }}" method="post" enctype="multipart/form-data" class="space-y-4">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label" for="input-order-id">{{ entry_order_id }}</label>
            <input type="text" name="order_id" value="{{ order_id }}" id="input-order-id" class="form-control" />
          </div>

          <div class="form-group">
            <label class="form-label" for="input-date-ordered">{{ entry_date_ordered }}</label>
            <input type="text" name="date_ordered" value="{{ date_ordered }}" id="input-date-ordered" class="form-control" />
          </div>
        </div>

        {{ return_fields }}

        <div class="flex items-center justify-between mt-4">
          <a href="{{ back }}" class="btn btn-ghost">{{ button_back }}</a>
          <button type="submit" class="btn btn-primary">{{ button_continue }}</button>
        </div>
      </form>
    </section>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
