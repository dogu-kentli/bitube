{{ header }}

<main id="account-recurring-info" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <section class="modern-card p-5">
      <h1 class="card-title">{{ heading_title }}</h1>

      <div class="mt-4">
        <p class="text-sm text-muted">{{ description }}</p>

        <div class="mt-4 table-responsive">
          <table class="table">
            <tbody>
              {% for transaction in transactions %}
                <tr>
                  <td>{{ transaction.date_added }}</td>
                  <td class="text-right">{{ transaction.amount }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="mt-4 text-right">
          <a href="{{ back }}" class="btn btn-ghost">{{ button_back }}</a>
        </div>
      </div>

    </section>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
