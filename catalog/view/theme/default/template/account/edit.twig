{{ header }}

<main id="account-edit" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    {{ content_top }}

    <div class="grid" style="display:grid;grid-template-columns:1fr 320px;gap:20px;">
      <section class="modern-card">
        <div class="card-head">
          <h1 class="card-title">{{ heading_title }}</h1>
        </div>

        <form action="{{ action }}" method="post" enctype="multipart/form-data" class="p-5 space-y-4">
          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="input-firstname">{{ entry_firstname }}</label>
              <input type="text" name="firstname" value="{{ firstname }}" placeholder="{{ entry_firstname }}" id="input-firstname" class="form-control" />
              {% if error_firstname %}<div class="text-danger mt-1">{{ error_firstname }}</div>{% endif %}
            </div>

            <div class="form-group">
              <label class="form-label" for="input-lastname">{{ entry_lastname }}</label>
              <input type="text" name="lastname" value="{{ lastname }}" placeholder="{{ entry_lastname }}" id="input-lastname" class="form-control" />
              {% if error_lastname %}<div class="text-danger mt-1">{{ error_lastname }}</div>{% endif %}
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="input-email">{{ entry_email }}</label>
              <input type="email" name="email" value="{{ email }}" placeholder="{{ entry_email }}" id="input-email" class="form-control" />
              {% if error_email %}<div class="text-danger mt-1">{{ error_email }}</div>{% endif %}
            </div>

            <div class="form-group">
              <label class="form-label" for="input-telephone">{{ entry_telephone }}</label>
              <input type="tel" name="telephone" value="{{ telephone }}" placeholder="{{ entry_telephone }}" id="input-telephone" class="form-control" />
              {% if error_telephone %}<div class="text-danger mt-1">{{ error_telephone }}</div>{% endif %}
            </div>
          </div>

          {{ custom_fields }}

          <div class="flex items-center justify-between mt-4">
            <a href="{{ back }}" class="btn btn-ghost">{{ button_back }}</a>
            <button type="submit" class="btn btn-primary">{{ button_continue }}</button>
          </div>
        </form>

      </section>

      <aside>
        {{ column_right }}
      </aside>
    </div>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
