{{ header }}

<main id="account-order-list" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <section class="modern-card p-5">
      <h1 class="card-title">{{ heading_title }}</h1>

      {% if orders %}
        <div class="table-responsive mt-4">
          <table class="table">
            <thead>
              <tr><th>{{ column_order_id }}</th><th>{{ column_customer }}</th><th>{{ column_status }}</th><th>{{ column_date_added }}</th><th class="text-right">{{ column_total }}</th></tr>
            </thead>
            <tbody>
              {% for order in orders %}
                <tr>
                  <td>{{ order.order_id }}</td>
                  <td>{{ order.customer }}</td>
                  <td>{{ order.status }}</td>
                  <td>{{ order.date_added }}</td>
                  <td class="text-right">{{ order.total }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% else %}
        <div class="mt-4">{{ text_empty }}</div>
      {% endif %}

      <div class="mt-4 flex items-center justify-between">
        <div>{{ pagination }}</div>
        <div class="text-right">{{ results }}</div>
      </div>

    </section>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
