{{ header }}

<main id="account-account" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    {{ content_top }}

    <div class="grid" style="display:grid;grid-template-columns: 1fr 320px; gap:20px;">
      <section class="modern-card">
        {% if success %}
        <div class="alert alert-success mb-4">
          <span class="icon"><i class="fa-solid fa-circle-check" aria-hidden="true"></i></span>
          <div>{{ success }}</div>
        </div>
        {% endif %}

        <div class="card-head">
          <div>
            <h2 class="card-title">Müşteri performansı</h2>
            <div class="card-sub">Örnek Kitabevi · Son 12 ay</div>
          </div>
          <a href="{{ order }}" class="btn btn-primary">Tüm siparişler</a>
        </div>

        <div class="mb-4">
          <!-- metric grid -->
          <div class="form-row">
            <div class="form-group modern-card">
              <div class="form-label">Uygun sipariş toplamı</div>
              <div class="h2">428.000 <small>TL</small></div>
              <div class="form-sub">Son 12 aylık alışveriş</div>
            </div>
            <div class="form-group modern-card">
              <div class="form-label">Mevcut indirim</div>
              <div class="h2"> %45 </div>
              <div class="form-sub">Standart üye</div>
            </div>
          </div>
        </div>

        <!-- recent orders table (responsive) -->
        <div class="table-responsive">
          {% if orders %}
          <table class="table">
            <thead>
              <tr><th>Sipariş</th><th>Tarih</th><th>Durum</th><th>Ürünler</th><th class="text-right">Toplam</th><th></th></tr>
            </thead>
            <tbody>
              {% for recent_order in orders %}
              <tr>
                <td>#{{ recent_order.order_id }}</td>
                <td>{{ recent_order.date_added }}</td>
                <td>{{ recent_order.status }}</td>
                <td>{{ recent_order.products }}</td>
                <td class="text-right">{{ recent_order.total }}</td>
                <td class="text-right"><a href="{{ recent_order.view }}" class="btn btn-ghost">Görüntüle</a></td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% else %}
          <div class="modern-card text-center">
            <div style="font-size:1.15rem; font-weight:700;">Henüz siparişiniz yok</div>
            <p class="form-sub">Sipariş verdiğinizde buradan görüntüleyebilirsiniz.</p>
          </div>
          {% endif %}
        </div>

      </section>

      <aside>
        {{ column_right }}
      </aside>
    </div>

    <div class="mt-6">{{ content_bottom }}</div>
  </div>
</main>

{{ footer }}
