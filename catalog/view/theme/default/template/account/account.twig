{{ header }}

<main id="account-account" class="flex-1 w-full bg-slate-50 px-4 py-8 text-slate-800 dark:bg-slate-950 dark:text-slate-100 sm:px-6 sm:py-10">
    <div class="mx-auto max-w-7xl">
        <nav aria-label="Breadcrumb" class="mb-6">
            <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                {% for breadcrumb in breadcrumbs %}
                <li class="flex items-center gap-2">
                    {% if not loop.first %}<i class="fa-solid fa-chevron-right text-[10px]" aria-hidden="true"></i>{% endif %}
                    {% if loop.last %}<span class="font-semibold text-indigo-600 dark:text-indigo-400" aria-current="page">{{ breadcrumb.text }}</span>
                    {% else %}<a href="{{ breadcrumb.href }}" class="transition hover:text-indigo-600 dark:hover:text-indigo-400">{{ breadcrumb.text }}</a>{% endif %}
                </li>
                {% endfor %}
            </ol>
        </nav>

        {{ content_top }}

        <div class="row">
            {{ column_left }}
            <section class="min-w-0 {% if column_left and column_right %}col-sm-6{% elseif column_left or column_right %}col-sm-9{% else %}col-sm-12{% endif %}">
                {% if success %}
                <div class="mb-5 flex items-start gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 p-4 text-sm text-emerald-800 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200" role="status">
                    <i class="fa-solid fa-circle-check mt-0.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true"></i><span>{{ success }}</span>
                </div>
                {% endif %}

                <section id="customerPerformanceCard" class="mb-6 overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-5 dark:border-slate-800 sm:px-7">
                        <div class="flex items-center gap-3">
                            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-300"><i class="fa-solid fa-chart-line" aria-hidden="true"></i></span>
                            <div>
                                <h2 class="text-lg font-extrabold text-slate-900 dark:text-white">Müşteri performansı</h2>
                                <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">{{ performance_company }} <span class="mx-1 text-slate-300 dark:text-slate-600">·</span> Tüm siparişler</p>
                            </div>
                        </div>
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-50 px-3 py-1.5 text-xs font-bold text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300"><i class="fa-solid fa-arrow-trend-up" aria-hidden="true"></i> Üyelik avantajı</span>
                    </div>

                    <div class="p-5 sm:p-7">
                        <div class="mb-6 grid gap-3 sm:grid-cols-2">
                            <div class="performance-metric rounded-2xl border border-slate-100 bg-slate-50/70 p-4 sm:p-5">
                                <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Mevcut sipariş toplamınız</p>
                                <p class="performance-value mt-2 text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">{{ performance_total }}</p>
                                <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">Geçerli durumdaki tüm siparişler</p>
                            </div>
                            <div class="performance-metric flex items-center justify-between rounded-2xl border border-slate-100 bg-slate-50/70 p-4 sm:p-5">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Mevcut indirim</p>
                                    <p class="performance-value mt-2 text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">%{{ performance_discount }}</p>
                                    <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">{{ performance_group_name }}</p>
                                </div>
                                <span class="flex h-12 w-12 items-center justify-center rounded-full border-4 border-indigo-100 text-sm font-extrabold text-indigo-600 dark:border-indigo-900 dark:text-indigo-300"><i class="fa-solid fa-percent" aria-hidden="true"></i></span>
                            </div>
                        </div>

                        <div class="performance-target rounded-2xl border border-indigo-100 bg-gradient-to-br from-indigo-50/80 to-white p-4 dark:border-indigo-900 dark:from-indigo-950/50 dark:to-slate-900 sm:p-5">
                            <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                                <div>
                                    <p class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-300">{% if performance_has_next_tier %}Bir sonraki hedef{% else %}Ulaşılabilecek en yüksek seviye{% endif %}</p>
                                    <h3 class="mt-1 font-bold text-slate-900 dark:text-white">{% if performance_has_next_tier %}{{ performance_next_group_name }} <span class="font-medium text-slate-500 dark:text-slate-400">· %{{ performance_next_discount }} indirim</span>{% else %}Tüm müşteri grubu hedeflerine ulaştınız{% endif %}</h3>
                                </div>
                                {% if performance_has_next_tier %}<div class="text-right"><p class="text-[11px] font-semibold text-slate-500 dark:text-slate-400">Hedef sipariş toplamı</p><p class="performance-value font-extrabold text-slate-900 dark:text-white">{{ performance_target }}</p></div>{% endif %}
                            </div>
                            <div class="performance-track h-2.5 overflow-hidden rounded-full bg-white dark:bg-slate-800" role="progressbar" aria-label="Mevcut indirim oranı" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ performance_progress }}">
                                <div class="performance-fill h-full rounded-full bg-emerald-600" style="width: {{ performance_progress }}%; background-image: repeating-linear-gradient(135deg, rgba(255,255,255,.24) 0, rgba(255,255,255,.24) 6px, transparent 6px, transparent 12px), linear-gradient(90deg, #15803d, #4ade80);"></div>
                            </div>
                            <div class="mt-2 flex items-center justify-between gap-3 text-xs text-slate-500 dark:text-slate-400">
                                <span class="font-bold text-slate-700 dark:text-slate-200">{% if performance_has_next_tier %}Hedefe {{ performance_remaining }} kaldı{% else %}Mevcut indirim{% endif %}</span>
                                <span class="font-semibold">{% if performance_has_next_tier %}%{{ performance_progress|round(1) }} tamamlandı{% else %}%{{ performance_discount }}{% endif %}</span>
                            </div>
                        </div>
                        <p class="mt-4 flex items-start gap-2 text-xs leading-relaxed text-slate-500 dark:text-slate-400"><i class="fa-regular fa-circle-question mt-0.5 text-indigo-500" aria-hidden="true"></i><span>İndirim oranı mevcut müşteri grubunuzdan, hedef ve ilerleme ise tüm siparişleriniz ile müşteri gruplarının harcama eşiklerinden hesaplanır.</span></p>
                    </div>
                </section>

                <div id="recentOrdersPanel" class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm transition-shadow duration-200 hover:shadow-md dark:border-slate-800 dark:bg-slate-900">
                    <div class="flex flex-col gap-4 border-b border-slate-100 px-5 py-5 dark:border-slate-800 sm:flex-row sm:items-center sm:justify-between sm:px-6">
                        <div class="flex items-center gap-3">
                            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600 dark:bg-indigo-950/60 dark:text-indigo-300"><i class="fa-solid fa-receipt" aria-hidden="true"></i></span>
                            <div>
                                <h2 class="text-lg font-bold text-slate-900 dark:text-white">Son siparişler</h2>
                                <p class="mt-0.5 text-sm text-slate-500 dark:text-slate-400">En son verdiğiniz 5 sipariş</p>
                            </div>
                        </div>
                        <div class="flex flex-col gap-2 sm:flex-row">
                            <a href="{{ shop }}" class="inline-flex min-h-10 items-center justify-center gap-2 rounded-xl bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-900"><i class="fa-solid fa-cart-shopping" aria-hidden="true"></i>Sipariş ver</a>
                            <a href="{{ order }}" class="group inline-flex min-h-10 items-center justify-center gap-2 rounded-xl border border-indigo-200 px-4 py-2 text-sm font-semibold text-indigo-700 transition hover:border-indigo-300 hover:bg-indigo-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2 dark:border-indigo-900 dark:text-indigo-300 dark:hover:border-indigo-700 dark:hover:bg-indigo-950/50 dark:focus-visible:ring-offset-slate-900">Tüm siparişler <i class="fa-solid fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5" aria-hidden="true"></i></a>
                        </div>
                    </div>

                    {% if orders %}
                    <div class="overflow-x-auto">
                        <table class="w-full min-w-[620px] text-left text-sm">
                            <thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500 dark:bg-slate-950/60 dark:text-slate-400">
                                <tr><th class="px-6 py-3 font-bold">Sipariş</th><th class="px-6 py-3 font-bold">Tarih</th><th class="px-6 py-3 font-bold">Durum</th><th class="px-6 py-3 font-bold">Ürün</th><th class="px-6 py-3 text-right font-bold">Toplam</th><th class="px-6 py-3"></th></tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
                                {% for recent_order in orders %}
                                <tr class="transition-colors hover:bg-indigo-50/50 dark:hover:bg-indigo-950/20">
                                    <td class="whitespace-nowrap px-4 py-4 font-bold text-slate-900 dark:text-white sm:px-6">#{{ recent_order.order_id }}</td>
                                    <td class="whitespace-nowrap px-4 py-4 text-slate-600 dark:text-slate-300 sm:px-6">{{ recent_order.date_added }}</td>
                                    <td class="whitespace-nowrap px-4 py-4 sm:px-6"><span class="inline-flex items-center gap-1.5 rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700 dark:bg-indigo-950/60 dark:text-indigo-300"><span class="h-1.5 w-1.5 rounded-full bg-indigo-500 dark:bg-indigo-400"></span>{{ recent_order.status }}</span></td>
                                    <td class="whitespace-nowrap px-4 py-4 text-slate-600 dark:text-slate-300 sm:px-6">{{ recent_order.products }}</td>
                                    <td class="whitespace-nowrap px-4 py-4 text-right font-bold text-slate-900 dark:text-white sm:px-6">{{ recent_order.total }}</td>
                                    <td class="whitespace-nowrap px-4 py-4 text-right sm:px-6"><a href="{{ recent_order.view }}" class="inline-flex items-center gap-1 rounded-lg font-semibold text-indigo-600 transition hover:text-indigo-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">Detay <i class="fa-solid fa-arrow-right text-[10px]" aria-hidden="true"></i></a></td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                    {% else %}
                    <div class="px-6 py-14 text-center">
                        <span class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-500 ring-8 ring-indigo-50/50 dark:bg-indigo-950/50 dark:text-indigo-400 dark:ring-indigo-950/20"><i class="fa-solid fa-box-open text-xl" aria-hidden="true"></i></span>
                        <h3 class="font-bold text-slate-800 dark:text-slate-100">Henüz siparişiniz yok</h3>
                        
                    </div>
                    {% endif %}
                </div>
            </section>
            {{ column_right }}
        </div>

        <div class="mt-8">{{ content_bottom }}</div>
    </div>
</main>

{{ footer }}
