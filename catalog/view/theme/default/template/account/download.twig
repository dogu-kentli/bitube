{{ header }}

<main id="account-download" class="modern-account">
  <div class="container">
    <nav aria-label="Breadcrumb" class="modern-breadcrumb mb-4">
      {% for breadcrumb in breadcrumbs %}
        {% if not loop.first %}<span aria-hidden="true">›</span>{% endif %}
        {% if loop.last %}
          <span class="crumb-current">{{ breadcrumb.text }}</span>
        {% else %}
          <a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a>
        {% endif %}
      {% endfor %}
    </nav>

    <div class="grid" style="display:grid;grid-template-columns: 1fr 320px; gap:20px;">
      <section class="modern-card">
        <h2 class="card-title">{{ heading_title }}</h2>

        <div class="p-0">
          {{ content_top }}

          {% if downloads %}
            <div class="table-responsive p-5">
              <table class="table">
                <thead>
                  <tr>
                    <th class="text-right">{{ column_order_id }}</th>
                    <th class="text-left">{{ column_name }}</th>
                    <th class="text-left">{{ column_size }}</th>
                    <th class="text-left">{{ column_date_added }}</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  {% for download in downloads %}
                    <tr>
                      <td class="text-right">{{ download.order_id }}</td>
                      <td>{{ download.name }}</td>
                      <td>{{ download.size }}</td>
                      <td>{{ download.date_added }}</td>
                      <td><a href="{{ download.href }}" data-toggle="tooltip" title="{{ button_download }}" class="btn btn-primary"><i class="fa fa-cloud-download"></i></a></td>
                    </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>

            <div class="p-5 flex items-center justify-between">
              <div>{{ pagination }}</div>
              <div>{{ results }}</div>
            </div>
          {% else %}
            <div class="p-5">{{ text_empty }}</div>
          {% endif %}

          <div class="p-5 border-t">
            <a href="{{ continue }}" class="btn btn-primary">{{ button_continue }}</a>
          </div>

          {{ content_bottom }}
        </div>
      </section>

      <aside>
        {{ column_right }}
      </aside>
    </div>
  </div>
</main>

{{ footer }}
