<!DOCTYPE html>
<!--[if IE]><![endif]-->
<!--[if IE 8 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie8"><![endif]-->
<!--[if IE 9 ]><html dir="{{ direction }}" lang="{{ lang }}" class="ie9"><![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
<html dir="{{ direction }}" lang="{{ lang }}">
<!--<![endif]-->
<head >

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<title>{{title}}</title>
<base href="{{ base }}" />
   
    <link href="catalog/view/theme/default/stylesheet/stylesheet.css" rel="stylesheet">
    <link href="catalog/view/theme/default/stylesheet/account.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        indigo: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            800: '#3730a3',
                            900: '#312e81',
                            950: '#1e1b4b',
                        }
                    }
                }
            }
        }
    </script>
    <script src="catalog/view/javascript/jquery/jquery-3.7.1.min.js" type="text/javascript"></script>
    

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts (Manrope) -->
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="catalog/view/javascript/common.js" type="text/javascript"></script>
</head>
<body class="bg-slate-50 text-slate-800 dark:bg-slate-950 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-300">

    <!-- Global Opencart-style Notification Container (Screen Center Top/Middle, Above Modal) -->
    <div id="globalAlertContainer" class="fixed top-6 left-1/2 -translate-x-1/2 z-[1060] w-full max-w-md px-4 pointer-events-none"></div>

    <!-- Top Navigation Bar -->
    <header class="w-full py-3 sm:py-4 px-3 sm:px-6 md:px-12 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between border-b border-slate-200 dark:border-slate-800 backdrop-blur-md bg-[rgba(255,255,255,0.6)] dark:bg-[rgba(6,8,20,0.36)]">
        <div class="relative flex w-full items-center justify-center space-x-2 sm:w-auto sm:justify-start sm:space-x-3">
            {% if show_account_menu_toggle %}
            <button id="accountMenuToggle" type="button" aria-controls="accountMenu" aria-expanded="false" aria-label="Hesap menüsünü aç" title="Hesap menüsü" class="absolute left-0 inline-f[...]
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>
            {% endif %}
        
            
            <div class="flex flex-col">
                <a href="{{ home }}"><span class="text-2xl font-extrabold tracking-tight bg-gradient-to-r from-indigo-600 to-indigo-400 bg-clip-text text-transparent leading-none"><img src="{{ logo }}" alt="{{ name }}" class="h-8 inline-block align-middle"/></span></a>
            </div>
            
        </div>
        
        <div class="flex items-center justify-center gap-2 sm:gap-3">
            <a href="tel:08500000000" class="inline-flex h-10 w-10 sm:w-auto items-center justify-center gap-2 rounded-xl border border-slate-200 dark:border-slate-700 bg-white/70 dark:bg-slate-900/30 px-3 py-2 text-sm">
                <i class="fa-solid fa-phone text-indigo-600 dark:text-indigo-400" aria-hidden="true"></i>
                <span class="hidden sm:inline">{{telephone}}</span>
            </a>
            {% if logged %}
            <a href="{{account}}" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">
                <i class="fa-solid fa-user" aria-hidden="true"></i><span>Müşteri :{{text_logged}}</span>
            </a>
            {% else %}
            <button type="button" data-bs-toggle="modal" data-bs-target="#loginModal" class="inline-flex items-center gap-2 rounded-xl bg-indigo-600 px-3 sm:px-4 py-2.5 text-xs sm:text-sm font-sem[...]
                <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i><span>{{"Giriş Yap"}}</span>
            </button>
            {% endif %}

            <!-- Theme Toggle -->
            <button id="themeToggle" type="button" aria-label="Karanlık temaya geç" class="w-10 h-10 rounded-full flex items-center justify-center text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition">
                <i id="themeIcon" class="fa-solid fa-moon text-lg"></i>
            </button>
        </div>
    </header>
     <div id="alert"></div>
