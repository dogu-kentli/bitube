{{header}}
   
    <main class="flex-grow flex flex-col items-center justify-center px-4 py-12">
        <div class="max-w-4xl w-full mx-auto text-center">
            
            <!-- Badge / Banner -->
            <div class="inline-flex items-center space-x-2 px-3.5 py-1.5 rounded-full bg-indigo-50 dark:bg-indigo-950/80 border border-indigo-200 dark:border-indigo-800/60 text-indigo-600 dark:text-indigo-400 text-xs font-semibold mb-6 shadow-xs">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Kurumsal Kitap Tedariki ve İndirim Platformu</span>
            </div>

            <h1 class="hero-ai-title text-4xl md:text-5xl font-extrabold tracking-tight mb-4 leading-tight text-slate-900 dark:text-white">
                <span class="hero-ai-line">Yayınevleri ve Kurumlar İçin</span><br>
                <span class="hero-ai-gradient">Özel İndirim Dünyası</span>
            </h1>
            
            <p class="text-lg text-slate-600 dark:text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
                Bireysel okurlarımız Vadi Yayınları mağazasından alışveriş yapabilir. Okullar, kütüphaneler ve şirketler ise kurumsal başvuru oluşturarak kurumlarına özel fiyatlandırma ve toplu sipariş seçeneklerinden yararlanabilir.
            </p>

            <!-- Dual Choice Cards -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-2xl mx-auto mb-16">
                
                <!-- Bireysel Card -->
                <a href="https://www.vadiyayinlari.com" target="_blank" rel="noopener noreferrer" 
                   class="group relative bg-white border border-slate-200 rounded-2xl p-8 text-left shadow-lg transition-all duration-300 flex flex-col justify-between">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl mb-6 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Bireysel</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
                            Güncel yayınlarımızı inceleyin ve Vadi Yayınları mağazası üzerinden siparişinizi oluşturun.
                        </p>
                    </div>
                    <div class="flex items-center text-indigo-600 dark:text-indigo-400 font-semibold text-sm group-hover:translate-x-1 transition-transform">
                        <span>Vadi Yayınları'na Git</span>
                        <i class="fa-solid fa-arrow-right ml-2"></i>
                    </div>
                </a>

                <!-- Kurumsal Card -->
                <a href="{% if customer_logged %}{{ account }}{% else %}#corporateModal{% endif %}" {% if not customer_logged %}data-bs-toggle="modal" data-bs-target="#corporateModal"{% endif %}
                   class="group relative bg-white border border-slate-200 rounded-2xl p-8 text-left shadow-lg transition-all duration-300 flex flex-col justify-between cursor-pointer">
                    <div>
                        <div class="w-12 h-12 rounded-xl bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-xl mb-6 group-hover:scale-110 transition-transform">
                            <i class="fa-solid fa-building-columns"></i>
                        </div>
                        <h2 class="text-2xl font-bold mb-2 text-slate-900 dark:text-white group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors">Kurumsal</h2>
                        <p class="text-sm text-slate-500 dark:text-slate-400 leading-relaxed mb-6">
                            Kurumunuza özel fiyatlandırma ve toplu sipariş seçenekleri için başvurun.
                        </p>
                    </div>
                    <div class="flex items-center text-indigo-600 dark:text-indigo-400 font-semibold text-sm group-hover:translate-x-1 transition-transform">
                        <span>Kurumsal Başvuru Oluştur</span>
                        <i class="fa-solid fa-arrow-right ml-2"></i>
                    </div>
                </a>

            </div>

            <!-- Corporate Trust Indicators / Footer Strip -->
            <div class="grid grid-cols-2 md:grid-cols-3 gap-4 pt-8 border-t border-slate-200 dark:border-slate-800/80 max-w-3xl mx-auto text-left">
                <div class="trust-box flex items-center space-x-3 p-3 rounded-xl bg-white border border-slate-200">
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-certificate"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Resmi Tedarikçi</div>
                        <div class="text-[11px] text-slate-500 dark:text-slate-400">Güvenilir iş ortaklığı</div>
                    </div>
                </div>
                <div class="trust-box flex items-center space-x-3 p-3 rounded-xl bg-white border border-slate-200">
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-percent"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Özel İskonto</div>
                        <div class="text-[11px] text-slate-500 dark:text-slate-400">Kurumlara özel oranlar</div>
                    </div>
                </div>
                <div class="trust-box col-span-2 md:col-span-1 flex items-center space-x-3 p-3 rounded-xl bg-white border border-slate-200">
                    <div class="w-8 h-8 rounded-lg bg-indigo-50 dark:bg-indigo-950/50 text-indigo-600 dark:text-indigo-400 flex items-center justify-center text-sm">
                        <i class="fa-solid fa-truck-fast"></i>
                    </div>
                    <div>
                        <div class="text-xs font-bold text-slate-800 dark:text-slate-200">Hızlı Sevkiyat</div>
                        <div class="text-[11px] text-slate-500 dark:text-slate-400">Toplu gönderim güvencesi</div>
                    </div>
                </div>
            </div>

        </div>
    </main>
   
    <!-- Customer Login Modal -->
    <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-white text-slate-800 border border-slate-200 rounded-2xl shadow-2xl overflow-hidden">
                <div class="modal-header border-b border-slate-200 px-6 py-4">
                    <h5 class="modal-title font-bold text-lg text-slate-900" id="loginModalLabel"><i class="fa-solid fa-lock mr-2 text-indigo-600"></i>Müşteri Girişi</h5>
                    <button type="button" class="btn-close dark:invert" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-6">
                    
                    <form id="loginForm" action="{{ login }}" method="post" class="space-y-4" novalidate>
                        <div>
                            <label for="loginIdentifier" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-600 dark:text-slate-300">E-posta / Müşteri No</label>
                            <input id="loginIdentifier" name="identifier" type="text" autocomplete="username" required placeholder="E-posta adresiniz veya müşteri numaranız" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm text-slate-900 dark:text-slate-100">
                        </div>
                        <div>
                            <label for="loginPassword" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-600 dark:text-slate-300">Şifre</label>
                            <input id="loginPassword" name="password" type="password" autocomplete="current-password" required placeholder="Şifreniz" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm text-slate-900 dark:text-slate-100">
                        </div>
                        <button type="submit" class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition text-sm inline-flex items-center justify-center gap-2"><i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i><span>Giriş Yap</span></button>
                    </form>
                    <div class="mt-4 text-center text-sm"><a href="#forgottenModal" id="forgottenModalTrigger" class="text-indigo-600 hover:text-indigo-700">Şifremi unuttum</a></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Forgotten Password Modal -->
    <div class="modal fade" id="forgottenModal" tabindex="-1" aria-labelledby="forgottenModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content bg-white text-slate-800 border border-slate-200 rounded-2xl shadow-2xl overflow-hidden dark:bg-slate-900 dark:text-slate-100 dark:border-slate-700">
                <div class="modal-header border-b border-slate-200 px-6 py-4 dark:border-slate-700">
                    <h5 class="modal-title font-bold text-lg text-slate-900 dark:text-white" id="forgottenModalLabel"><i class="fa-solid fa-key mr-2 text-indigo-600 dark:text-indigo-400" aria-hidden="true"></i>Şifremi Unuttum</h5>
                    <button type="button" class="btn-close dark:invert" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-6">
                    <p class="mb-4 text-sm text-slate-600 dark:text-slate-300">Sıfırlama bağlantısını göndermemiz için hesabınıza kayıtlı e-posta adresini girin.</p>
                    <form id="forgottenForm" action="{{ forgotten }}" method="post" class="space-y-4" novalidate>
                        <div>
                            <label for="forgottenEmail" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-600 dark:text-slate-300">E-posta adresi</label>
                            <input id="forgottenEmail" name="email" type="email" autocomplete="email" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm text-slate-900 dark:text-slate-100" placeholder="ornek@firma.com">
                        </div>
                        <button id="forgottenSubmit" type="submit" class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl transition text-sm inline-flex items-center justify-center gap-2"><i class="fa-solid fa-paper-plane" aria-hidden="true"></i><span>Bağlantı Gönder</span></button>
                    </form>
                    <div class="mt-4 text-center text-sm"><a href="#loginModal" id="backToLoginModal" class="text-indigo-600 hover:text-indigo-700 dark:text-indigo-400">Giriş ekranına dön</a></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Corporate Registration Modal -->
    <div class="modal fade" id="corporateModal" tabindex="-1" aria-labelledby="corporateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-white text-slate-800 border border-slate-200 rounded-2xl shadow-2xl overflow-hidden">
                <div class="modal-header border-b border-slate-200 dark:border-slate-800 px-6 py-4 flex items-center justify-between">
                    <h5 class="modal-title font-bold text-lg flex items-center gap-2 text-slate-900 dark:text-white" id="corporateModalLabel">
                        <i class="fa-solid fa-file-invoice-dollar text-indigo-600 dark:text-indigo-400"></i> KURUM/FİRMA KAYIT FORMU
                    </h5>
                    <button type="button" class="btn-close dark:bg-slate-800 dark:p-2 dark:rounded-lg dark:text-white dark:opacity-80 filter dark:invert" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body p-6">
                    <form id="form-register" class="space-y-4" novalidate>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Kurum / Firma Adı</label>
                            <input type="text" name="company" placeholder="Kurum/Firma adı" maxlength="100" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100">
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="contactFirstName" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Yetkili Adı</label>
                                <input id="contactFirstName" name="firstname" type="text" autocomplete="given-name" placeholder="Ad" maxlength="32" required class="w-full px-3 sm:px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100">
                            </div>
                            <div>
                                <label for="contactLastName" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Yetkili Soyadı</label>
                                <input id="contactLastName" name="lastname" type="text" autocomplete="family-name" placeholder="Soyadı" maxlength="32" required class="w-full px-3 sm:px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Telefon Numarası</label>
                                <input type="tel" name="telephone" placeholder="05XX XXX XX XX" minlength="3" maxlength="32" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Kurumsal E-posta</label>
                                <input type="email" name="email" placeholder="kurum@domain.com" maxlength="96" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <div>
                                <label for="taxNumber" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Vergi Numarası</label>
                                <input id="taxNumber" name="tax_number" type="text" inputmode="numeric" pattern="[0-9]{10}([0-9])?" minlength="10" maxlength="11" placeholder="Vergi numarası" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100">
                            </div>
                            <div>
                                <label for="taxOffice" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Vergi Dairesi</label>
                                <input id="taxOffice" name="tax_office" type="text" minlength="2" maxlength="60" placeholder="Vergi dairesi" required class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Açık Adres</label>
                            <textarea rows="2" name="address" minlength="10" maxlength="256" required placeholder="İl, İlçe, Mahalle ve açık adres bilgisi..." class="w-full px-4 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-800 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 text-slate-900 dark:text-slate-100"></textarea>
                        </div>
                        <div>
                            <label for="corporateDocuments" class="block text-xs font-semibold uppercase tracking-wider mb-1 text-slate-500 dark:text-slate-400">Vergi Levhası <span class="text-rose-600">(Zorunlu)</span> ve Diğer Belgeler</label>
                            <label id="documentDropzone" for="corporateDocuments" tabindex="0" class="group flex min-h-36 cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-300 bg-slate-50/70 px-5 py-6 text-center transition hover:border-indigo-400 hover:bg-indigo-50/70 dark:border-slate-600 dark:bg-slate-800/50 dark:hover:border-indigo-400 dark:hover:bg-indigo-950/30">
                                <span class="mb-3 flex h-11 w-11 items-center justify-center rounded-full bg-indigo-100 text-indigo-600 transition group-hover:scale-105 dark:bg-indigo-950 dark:text-indigo-300"><i class="fa-solid fa-cloud-arrow-up text-lg" aria-hidden="true"></i></span>
                                <span class="text-sm font-semibold text-slate-700 dark:text-slate-200">Belgeleri sürükle bırak veya gözat</span>
                               
                                <span class="mt-3 rounded-full bg-white px-3 py-1 text-[11px] font-medium text-slate-500 ring-1 ring-slate-200 dark:bg-slate-900 dark:text-slate-400 dark:ring-slate-700">WEBP, PDF, PNG, JPG ,JPEG</span>
                                <input id="corporateDocuments" type="file" multiple accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" aria-describedby="documentHelp selectedDocuments" class="sr-only">
                            </label>
                           
                            <ul id="selectedDocuments" role="status" class="mt-2 space-y-1 text-xs text-slate-600 dark:text-slate-300"></ul>
                            <p id="documentError" role="alert" class="hidden mt-2 text-xs font-medium text-rose-600 dark:text-rose-400"></p>
                        </div>
                        <div class="pt-2">
                            <button id="modal-button-register" type="button" class="w-full py-3 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-xl shadow-lg shadow-indigo-500/25 transition-all text-sm cursor-pointer flex items-center justify-center gap-2">
                                <i class="fa-solid fa-paper-plane" aria-hidden="true"></i>
                                <span id="btnText">KAYDET</span>
                            </button>
                        </div>
                    </form>
                    <div id="successMessage" class="hidden mt-4 p-4 rounded-xl bg-indigo-50 dark:bg-indigo-950/80 border border-indigo-200 dark:border-indigo-800 text-indigo-700 dark:text-indigo-300 text-center text-sm font-medium">
                        <i class="fa-solid fa-circle-check mr-2"></i> Başvurunuz alındı! İndirim oranlarınız ve kurumsal üyelik detaylarınız e-posta adresinize gönderilecektir.
                    </div>
                </div>
            </div>
        </div>
    </div>

     {{footer}}
